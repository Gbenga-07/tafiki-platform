# Tafiki API configuration. Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=4000
# Public addresses
APP_URL=https://tafiki.com
API_URL=https://api.tafiki.com
CONSOLE_PATH=/console
# Allowed browser origins (comma separated)
CORS_ORIGINS=https://tafiki.com,https://www.tafiki.com

# Database: mysql2 for MySQL/MariaDB (InterServer), better-sqlite3 for local testing
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tafiki
DB_USER=tafiki
DB_PASSWORD=change-me
# Only for better-sqlite3
DB_FILE=./data/tafiki.sqlite

# Security: long random strings (run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace-with-a-long-random-string
COOKIE_DOMAIN=.tafiki.com

# Email (SMTP from your provider: Resend, Postmark, Zoho ZeptoMail, Google Workspace...)
MAIL_FROM="Tafiki <updates@tafiki.com>"
MAIL_REPLY_TO=support@tafiki.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Paystack (Settings > API Keys & Webhooks on dashboard.paystack.com). Webhook URL: https://api.tafiki.com/webhooks/paystack
# Flutterwave (checkout shows Flutterwave and bank transfer). Test keys start FLWSECK_TEST-, live keys FLWSECK-.
# FLW_SECRET_HASH is the secret hash you type on the Flutterwave dashboard webhook page (Settings > Webhooks),
# with the webhook URL https://api.tafiki.com/webhooks/flutterwave
FLW_SECRET_KEY=
FLW_SECRET_HASH=
# Paystack (kept for older payments; no longer offered at checkout)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Smile ID (portal.usesmileid.com). SMILE_ENV=sandbox for testing, production when live.
# Callback URL to register: https://api.tafiki.com/webhooks/smileid
SMILE_PARTNER_ID=
SMILE_API_KEY=
SMILE_ENV=sandbox
# Result codes that verify a member automatically (confirm the list with Smile ID for your products)
SMILE_APPROVED_CODES=1012,1020,0810

# Test mode only: lets `npm run sim:advance -- 28` move the platform's dates forward to try audits and payouts.
# Remove it (leave empty) before going live.
SIMULATION=

# First Super Admin (used once by: npm run create-admin)
SUPERADMIN_NAME=Tafiki Operations
SUPERADMIN_EMAIL=ops@tafiki.com
SUPERADMIN_PASSWORD=

# One-time codes by email: asked for before withdrawals and bank changes. Leave on in production.
OTP_REQUIRED=on

# Console AI assistant: reads live data, never changes it. Get a key at console.anthropic.com. Leave empty to keep it off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Checkout offers Flutterwave and bank transfer to escrow. A bank transfer holds the units for RELEASE_AFTER_HOURS (24)
# and is confirmed by Finance in the console. Set to off to offer Flutterwave only.
MANUAL_TRANSFERS=on
# Hours a payment can stay unconfirmed before the team may release its units in the console.
RELEASE_AFTER_HOURS=24
